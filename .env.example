# LLM provider (llm-agnostic core): "claude" (default, hosted, best tool-use
# quality) or "ollama" (free, self-hosted, proof-of-concept quality on CPU -
# requires Ollama running locally with the model already pulled)
LLM_PROVIDER=claude

# Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434

# Home Assistant (unused until phase 1 - no domain tools registered yet)
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=

# Backend
JARVIS_PORT=8000
JARVIS_DB_PATH=jarvis.db
