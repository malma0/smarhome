# LLM provider (llm-agnostic core): "claude" (hosted, best tool-use quality,
# paid), "groq" (free tier, no credit card, open-weight models, no local
# GPU needed), or "ollama" (free, self-hosted, proof-of-concept quality on
# CPU - requires Ollama running locally with the model already pulled)
LLM_PROVIDER=claude

# Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Groq (only used when LLM_PROVIDER=groq) - key from console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434

# Home Assistant (unused until phase 3 - no domain tools registered yet)
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=

# Backend
JARVIS_PORT=8000
JARVIS_DB_PATH=jarvis.db

# Desktop voice app (phase 1) TTS: "piper" (fully open-source, fully
# offline neural voice - recommended, needs the model downloaded once, see
# README), "edge" (free neural voices, needs internet, but it's a Microsoft
# service, not open source), or "sapi" (offline Windows voices, lowest
# quality). "sapi" is always used automatically as a fallback if the
# configured provider fails.
TTS_PROVIDER=piper
PIPER_MODEL_PATH=voices/ru_RU-irina-medium.onnx
PIPER_CONFIG_PATH=voices/ru_RU-irina-medium.onnx.json
EDGE_TTS_VOICE=ru-RU-DmitryNeural
