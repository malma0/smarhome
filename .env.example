# LLM provider (llm-agnostic core): "claude" (hosted, best tool-use quality,
# paid), "groq" (free tier, no credit card, open-weight models, no local
# GPU needed), or "ollama" (free, self-hosted, proof-of-concept quality on
# CPU - requires Ollama running locally with the model already pulled)
LLM_PROVIDER=claude

# Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Groq (only used when LLM_PROVIDER=groq) - key from console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Lower than Groq's own API default (1.0) - observed live to noticeably
# reduce repetitive/garbled replies from this model, especially right after
# a multi-tool-call turn. Doesn't eliminate the risk (it's the model, not a
# bug), just makes it rarer.
GROQ_TEMPERATURE=0.4

# Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434

# Home Assistant (unused until phase 3 - no domain tools registered yet)
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=

# Backend
JARVIS_PORT=8000
JARVIS_DB_PATH=jarvis.db

# Desktop voice app (phase 1): set to false to make Jarvis reply as text
# only, skipping speech synthesis entirely (useful while testing tool use -
# no waiting on TTS for every reply). STT (listening) still works either way.
JARVIS_TTS_ENABLED=true

# Desktop voice app (phase 1) TTS: "piper" (fully open-source, fully
# offline, fast and reliable, but only 4 mediocre-quality Russian voices
# exist), "edge" (free neural voices via Microsoft's read-aloud service -
# noticeably better quality, needs internet, occasionally has a slow/failed
# request - falls back to "sapi" automatically when that happens), "sapi"
# (offline Windows voices, lowest quality, always the automatic fallback),
# "elevenlabs" (by far the best quality/selection, but its free tier does
# NOT allow using ANY library or premade voice via the API - only a voice
# you've instant-cloned yourself, or a paid plan; see README before
# assuming this one is free to use), or "voicebox" (local voice cloning via
# github.com/jamiepine/voicebox + Chatterbox - genuinely free and fully
# offline, but needs voicebox-server.exe already running locally and a
# cloned voice profile already created; generation is slow on CPU, see
# docs/TZ.md for measured numbers).
TTS_PROVIDER=edge
PIPER_MODEL_PATH=voices/ru_RU-irina-medium.onnx
PIPER_CONFIG_PATH=voices/ru_RU-irina-medium.onnx.json
EDGE_TTS_VOICE=ru-RU-SvetlanaNeural

# ElevenLabs (only used when TTS_PROVIDER=elevenlabs) - see the free-tier
# caveat above before choosing this. Key from elevenlabs.io -> Developers ->
# API Keys; voice_id from a voice you've instant-cloned yourself.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Voicebox (only used when TTS_PROVIDER=voicebox) - run voicebox-server.exe
# from its own install directory first (NOT this repo - its default port
# 8000 also collides with JARVIS_PORT, don't run both at once), create a
# cloned voice profile in its own UI/API, then put that profile's name here.
VOICEBOX_BASE_URL=http://127.0.0.1:8000
VOICEBOX_PROFILE=
# Optional but recommended: a ~10-30s clean WAV of the voice (relative to
# backend/), with its transcript in a .txt of the same name next to it
# (voice.wav -> voice.txt). If the running Voicebox has no profile named
# VOICEBOX_PROFILE, Jarvis creates it from this file automatically - so the
# voice survives a fresh Voicebox install or a different Voicebox data folder.
VOICEBOX_REFERENCE_WAV=
VOICEBOX_ENGINE=chatterbox
VOICEBOX_LANGUAGE=ru
# Add Russian stress marks before sending text to Voicebox (Chatterbox was
# trained on them, Voicebox never adds them - see app/tts/stress.py).
# RUACCENT_MODEL: tiny2.1 (~400 MB with its pipeline) or turbo3.1 (~730 MB,
# most accurate) - downloaded into backend/models/ruaccent on first use.
VOICEBOX_RUSSIAN_STRESS=true
RUACCENT_MODEL=tiny2.1

# Desktop voice app: "wake" = hands-free, say the name to wake Jarvis up
# (needs vosk + its Russian model, see README); "push" = Enter to start and
# stop recording. Falls back to "push" by itself if Vosk isn't installed.
VOICE_MODE=wake
# Words that wake Jarvis, as the local recognizer spells them. Must be
# words its dictionary knows - "джервис" is how it hears some voices say
# "Джарвис" (verified), so keep both when changing nothing else.
WAKE_WORDS=джарвис,джервис
VOSK_MODEL_PATH=models/vosk-model-small-ru-0.22
# After just the name: how long to wait for the command. After a reply: how
# long to keep listening for a follow-up without the name, before sleeping.
WAKE_LISTEN_SECONDS=8
FOLLOW_UP_SECONDS=10

# Desktop voice app: recognize who's speaking from their voice
# (app/speaker_id.py). Needs the extra resemblyzer install step in README.
VOICE_ID_ENABLED=true
VOICE_ID_THRESHOLD=0.75

# Extra words for Whisper's vocabulary hint, comma-separated - room and
# device names, pets, anything it keeps mishearing. Added on top of a
# built-in list (Джарвис, YouTube, Майнкрафт, ...) and every resident's name.
WHISPER_VOCABULARY=

# Keep every voice utterance (audio + transcript + your typed corrections)
# as training data for fine-tuning speech recognition later. Stored only on
# this machine, in backend/<JARVIS_DATASET_DIR>/ (gitignored).
JARVIS_DATASET_ENABLED=true
JARVIS_DATASET_DIR=dataset
