# LLM provider (llm-agnostic core - "claude" is the only adapter for now)
LLM_PROVIDER=claude

# Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Home Assistant (unused until phase 1 - no domain tools registered yet)
HOME_ASSISTANT_URL=http://localhost:8123
HOME_ASSISTANT_TOKEN=

# Backend
JARVIS_PORT=8000
JARVIS_DB_PATH=jarvis.db
