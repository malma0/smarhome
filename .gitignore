# secrets - never commit
.env

# Local tool config - must never show up in this repo
.claude/

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Jarvis's own SQLite state (per-house data, not source)
backend/*.db
# the flat's plan drawn in the app (app/layout.py) - this home's own
backend/layout.json
backend/layout.backup.json
# guests' codes made in the app (app/people.py) - this home's own
backend/guests.json

# downloaded Piper voice models (tens of MB, fetched by README instructions)
backend/voices/

# downloaded speech models - Vosk (wake word / offline STT), ruaccent
# (Russian stress marks) - fetched by README instructions / on first use
backend/models/

# voice-cloning reference samples and test generations (personal audio, not
# source - see README for how these were sourced/created)
backend/voice_reference/

# recorded utterances kept as speech-recognition training data (residents'
# own voices - personal data, never leaves the machine)
backend/dataset/

# audio behind every voice-profile sample (residents' own voices - personal
# data), kept to rebuild profiles and train a household speaker model
backend/voiceprints/

# home assistant runtime state (not our mock config)
homeassistant/config/.storage/
homeassistant/config/.ha_run.lock
homeassistant/config/.HA_VERSION
homeassistant/config/home-assistant.log*
homeassistant/config/home-assistant_v2.db*
homeassistant/config/secrets.yaml
homeassistant/config/deps/
homeassistant/config/tts/
homeassistant/config/blueprints/

# Jarvis window log (pythonw has no console - see backend/jarvis_gui.py)
backend/*.log

# Own-model training: the teacher cache and trained models stay local
backend/training/cache/
backend/training/runs/
*.gguf
# and the MLflow store of the versions (training/tracking.py) - local, like the models
backend/training/mlflow.db
backend/training/mlartifacts/
backend/mlruns/

# the Android app build (android/build.py) - made, not source
android/build/

# schedules made in the app (HA writes them here) - this home's own
homeassistant/config/automations.yaml

# takes for the own wake-word model (backend/wakeword/record.py) - the residents' voices, never leave the PC
backend/wakeword/data/
backend/wakeword/models/
